# Пережатые копии кадров под srcset — собираются из мастеров на каждой сборке
# (web/scripts/gen-shots.mjs). В репозиторий не кладутся намеренно: он публичный,
# и 4,4 МБ производных двоичных файлов удвоили бы его вес рядом с мастерами.
# Разойтись с мастером они не могут — пересобираются из него же.
web/public/shots/_r/
